  \n    return '0'.join(encoded_parts)\n\n\ndef unary_decode(encoded_message):\n    \"\"\"\n    Decode a Unary encoded message back to the original string.\n    \"\"\"\n    if not encoded_message:\n        return \"\"\n    \n    parts = encoded_message.split('0')\n    decoded_chars = []\n    for part in parts:\n        if part:\n            unicode_value = len(part)\n            decoded_chars.append(chr(unicode_value))\n    \n    return ''.join(decoded_chars)\n\n\ndef main():\n    print(\"=\" * 60)\n    print(\"UNARY ENCODING PROGRAM\")\n    print(\"=\" * 60)\n    \n    message = input(\"\\nEnter a message to encode: \")\n    \n    if not message:\n        print(\"\\nError: Empty message!\")\n        return\n    \n    encoded = unary_encode(message)\n    \n    print(\"\\n\" + \"-\" * 60)\n    print(\"ORIGINAL MESSAGE:\")\n    print(f\"  {message}\")\n    print(\"\\nENCODED MESSAGE (Unary):\")\n    print(f\"  {encoded}\")\n    print(\"-\" * 60)\n    \n    # Show character breakdown for clarity\n    print(\"\\nCHARACTER BREAKDOWN:\")\n    for i, char in enumerate(message):\n        unicode_val = ord(char)\n        print(f\"  '{char}' (Unicode: {unicode_val}) → {'1' * min(unicode_val, 50)}{'...' if unicode_val > 50 else ''}\")\n    \n    # Verification\n    print(\"\\n\" + \"-\" * 60)\n    print(\"VERIFICATION:\")\n    decoded = unary_decode(encoded)\n    print(f\"  Decoded back: {decoded}\")\n    print(f\"  Match: {'✓ YES' if decoded == message else '✗ NO'}\")\n    print(\"=\" * 60)\n\n\nif __name__ == \"__main__\":\n    main()\n```\n\n## How It Works\n\n- **Encoding**: Each character is converted to its Unicode value using `ord()`, then represented by that many `1`s. Characters are separated by `0`.\n- **Decoding**: The encoded string is split by `0`, and each segment's length gives the original Unicode value, converted back using `chr()`.\n- **Safety**: The program handles empty input and verifies decoding accuracy.\n\n## Example\n\n**Input:**\n```\nHi\n```\n\n**Out